# RPC devnet do CLIENTE (escrita/wallet). Público serve, mas é inlined no bundle — não ponha chave aqui.
NEXT_PUBLIC_RPC=https://api.devnet.solana.com

# RPC de LEITURA no SERVIDOR (timeline via getSignaturesForAddress). O devnet público NÃO retorna
# histórico de assinaturas — use um RPC com índice (ex.: QuickNode). Server-only: a chave NÃO vaza no
# cliente. Se vazio, cai no NEXT_PUBLIC_RPC. Em produção (Vercel) defina esta.
SOLANA_RPC=

# Endereço da collection Core criada pelo scripts/seed.ts
NEXT_PUBLIC_COLLECTION=

# Liga os dados de demonstração (lib/mock.ts). DESLIGAR no deploy final (§9).
NEXT_PUBLIC_MOCK=1

# Segredo do servidor: sha256(chassi + PEPPER) na rota /api/commit. NUNCA no client.
VIN_PEPPER=troque-por-uma-string-aleatoria

# Só para scripts/seed.ts — keypair DESCARTÁVEL de devnet, financiada. NUNCA a private key da sua Phantom real.
# base58 OU json array de 64 bytes. (Alternativa: SEED_KEYPAIR_PATH=/caminho/id.json)
SEED_SECRET_KEY=

# Produção (Vercel): banco Turso (libsql cloud) p/ escrita persistente no serverless.
# Local, se vazio, usa o arquivo file: (data/placa-limpa.db). Ver README.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
